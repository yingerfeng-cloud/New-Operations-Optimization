# Native runtime defaults
OPTIFORGE_DATA_DIR=data
OPTIFORGE_RUNTIME_STORE=data/runtime_store.json
RUNTIME_STORE_PATH=data/runtime_store.json
OPTIFORGE_SOLVER_MODE=native

# API/frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
SERVICE_MODE=combined
OPTIMIZATION_PLATFORM_BASE_URL=http://127.0.0.1:8000
AGENT_PLATFORM_ACCESS_MODE=in_process
AGENT_ALLOW_IN_PROCESS_PLATFORM_FALLBACK=false
OPTIMIZATION_PLATFORM_TIMEOUT_SECONDS=60
OPTIMIZATION_PLATFORM_STATUS_TIMEOUT_SECONDS=3

# Optional API token (all entry points). Browsers prompt for it after a 401.
OPTIMIZATION_PLATFORM_API_TOKEN=

# Stable LLM config secret; retain it across rebuilds/migrations.
# If empty, the local data directory gets a private .optiforge-config-secret file.
OPTIFORGE_CONFIG_SECRET=
# OPTIFORGE_CONFIG_SECRET_FILE=/run/secrets/optiforge_config
# Optional local LLM JSON import path; defaults to the runtime data directory.
# Import explicitly from Settings after filling API Key; later Settings edits win.
# OPTIFORGE_LLM_CONFIG_FILE=/absolute/path/llm.local.json

# Docker Compose maps backend to http://127.0.0.1:18000 and stores data in ./docker-data
# The compose file overrides OPTIFORGE_DATA_DIR and RUNTIME_STORE_PATH to /app/data.
